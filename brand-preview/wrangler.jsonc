{
  // Brand-preview worker. Has a small in-preview API so shareable /p/<id>
  // links work here, without D1, KV, or production data.
  // Do not point this at wod, wod-design-test, or wod-components-preview.
  "name": "wod-brand-preview",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": true
  }
}
